diff --git a/modules/ii/sidebarRight/SidebarRightContent.qml b/modules/ii/sidebarRight/SidebarRightContent.qml
--- a/modules/ii/sidebarRight/SidebarRightContent.qml
+++ b/modules/ii/sidebarRight/SidebarRightContent.qml
@@ -36,6 +36,33 @@ Item {

     readonly property MprisPlayer activePlayer: MprisController.activePlayer
     readonly property var realPlayers: MprisController.players
+
+    function filterDuplicatePlayers(players) {
+        const filtered = []
+        const used = new Set()
+
+        for (let i = 0; i < players.length; ++i) {
+            if (used.has(i)) continue
+            const first = players[i]
+            const group = [i]
+
+            for (let j = i + 1; j < players.length; ++j) {
+                const second = players[j]
+                if ((first.trackTitle && second.trackTitle &&
+                     (first.trackTitle.includes(second.trackTitle) || second.trackTitle.includes(first.trackTitle))) ||
+                    (first.position - second.position <= 2 && first.length - second.length <= 2)) {
+                    group.push(j)
+                }
+            }
+
+            const withArt = group.find(index => players[index].trackArtUrl?.length > 0)
+            const chosen = withArt === undefined ? group[0] : withArt
+            filtered.push(players[chosen])
+            group.forEach(index => used.add(index))
+        }
+        return filtered
+    }
+
     readonly property var meaningfulPlayers: {
         const preferred = Config.options.bar.media.preferredPlayer.trim().toLowerCase()
         if (preferred.length === 0) return filterDuplicatePlayers(realPlayers)
