-                imageRegions = RegionFunctions.filterImageRegions(
-                    JSON.parse(imageDimensionCollector.text),
-                    root.windowRegions
-                );
+                const output = imageDimensionCollector.text.trim();
+                if (output.length === 0) {
+                    imageRegions = [];
+                    return;
+                }
+                try {
+                    imageRegions = RegionFunctions.filterImageRegions(
+                        JSON.parse(output),
+                        root.windowRegions
+                    );
+                } catch (error) {
+                    console.warn(`[Region Selector] Invalid content-region output: ${error}`);
+                    imageRegions = [];
+                }
             }
         }
     }
diff --git a/modules/ii/regionSelector/OptionsToolbar.qml b/modules/ii/regionSelector/OptionsToolbar.qml
--- a/modules/ii/regionSelector/OptionsToolbar.qml
+++ b/modules/ii/regionSelector/OptionsToolbar.qml
@@ -31,7 +31,22 @@ Toolbar {
         ]
-        currentIndex: root.selectionMode === RegionSelection.SelectionMode.RectCorners ? 0 : 1
+        function syncFromSelectionMode() {
+            const nextIndex = root.selectionMode === RegionSelection.SelectionMode.RectCorners ? 0 : 1;
+            if (currentIndex !== nextIndex) {
+                setCurrentIndex(nextIndex);
+            }
+        }
+        Component.onCompleted: syncFromSelectionMode()
+        Connections {
+            target: root
+            function onSelectionModeChanged() {
+                tabBar.syncFromSelectionMode();
+            }
+        }
         onCurrentIndexChanged: {
-            root.selectionMode = currentIndex === 0 ? RegionSelection.SelectionMode.RectCorners : RegionSelection.SelectionMode.Circle;
+            const nextSelectionMode = currentIndex === 0 ? RegionSelection.SelectionMode.RectCorners : RegionSelection.SelectionMode.Circle;
+            if (root.selectionMode !== nextSelectionMode) {
+                root.selectionMode = nextSelectionMode;
+            }
         }
     }
 }
