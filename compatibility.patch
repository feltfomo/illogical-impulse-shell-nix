diff --git a/modules/ii/regionSelector/RegionSelection.qml b/modules/ii/regionSelector/RegionSelection.qml
--- a/modules/ii/regionSelector/RegionSelection.qml
+++ b/modules/ii/regionSelector/RegionSelection.qml
